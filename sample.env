# =============================================================================
# RHOAI Custom Deep Research Lab — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp sample.env .env
#
# Two access modes are supported:
#
#   Mode A — Direct vLLM route (no MaaS)
#     LLM_BASE_URL  = https://<model-route>/v1
#     LLM_API_KEY   = <oc-token or "not-needed">
#     MAAS_API_KEY  = (leave empty)
#
#   Mode B — MaaS API gateway
#     LLM_BASE_URL  = https://<maas-api-route>/<namespace>/<model>/v1
#     LLM_API_KEY   = (ignored when MAAS_API_KEY is set)
#     MAAS_API_KEY  = sk-oai-... (MaaS API key bound to subscription)
#
# =============================================================================

# --- LLM Configuration (RHOAI Model Serving / OpenAI-compatible) ---
# Direct route example : https://granite-llm-doc-research.apps.cluster.example.com/v1
# MaaS gateway example : https://maas-api.apps.cluster.example.com/demo/granite-llm/v1
LLM_BASE_URL=https://<your-llm-route>/v1
LLM_API_KEY=<your-api-key>
LLM_MODEL=granite-3.3-8b-instruct

# MaaS API key (required for MaaS gateway, leave empty for direct routes)
# POST /chat/completions requires this key; OC tokens only work for GET /models
MAAS_API_KEY=

# --- Embedding Model (fallback) ---
# Optional: Used as fallback when Llama Stack model auto-discovery fails.
# Llama Stack handles embeddings internally; these are only needed if you
# serve embeddings separately outside Llama Stack.
# EMBEDDING_BASE_URL=https://<your-embedding-route>/v1
# EMBEDDING_API_KEY=<your-api-key>
EMBEDDING_MODEL=granite-embedding-278m-multilingual

# --- Llama Stack (RHOAI 3.4 — RAG: Files, Vector Stores, Search) ---
# Document ingestion and vector search are handled by Llama Stack.
# Llama Stack exposes OpenAI-compatible APIs (Files, Vector Stores, Responses).
#
# Finding your URL:
#   External route:  oc get route -n <project> -l app.kubernetes.io/name=llama-stack-distribution \
#                      -o jsonpath='https://{.items[0].spec.host}'
#   Internal (in-cluster): http://lsd-<project>-service.<namespace>.svc.cluster.local:8321
#
# The /v1 suffix is required for OpenAI SDK compatibility.
#
# API key: If authentication is not configured on the Llama Stack server,
#   use any non-empty value (e.g. "not-needed"). To enable token-based auth,
#   configure the LlamaStackDistribution CR with OIDC or bearer token settings.
LLAMA_STACK_URL=https://<your-llama-stack-route>/v1
LLAMA_STACK_API_KEY=not-needed
#
# Vector DB (pgvector) is configured inside the Llama Stack ConfigMap
# (llama-stack-config-v2, vector_io section) and runs on a cluster
# PostgreSQL instance. The local backend accesses it indirectly through
# the Llama Stack API — no direct pgvector connection is needed here.

# --- PostgreSQL (harness state: checkpointing, chat history, sessions) ---
# Local-only PostgreSQL for LangGraph checkpointing, chat history,
# and harness state (sessions, traces, failures).
# This is separate from the cluster pgvector DB used by Llama Stack.
# Provisioned automatically by: make setup
POSTGRES_URL=postgresql://research:research@localhost:5432/research_db

# --- SSL Verification ---
# Set to false for self-signed certificates on sandbox/lab clusters
VERIFY_SSL=true

# --- LLM Token Limits ---
# always set max_tokens to prevent MaaS gateway timeouts.
LLM_MAX_TOKEN_SMALL=512
LLM_MAX_TOKEN_MEDIUM=1024
LLM_MAX_TOKEN_LARGE=4096

# --- Harness Configuration ---
QUALITY_THRESHOLD=7.0
MAX_ITERATIONS=2
PARALLEL_WORKERS=3

# Sectioned report: when true, planning decomposes queries into sub-topics
# and the execute phase writes per-section reports. Set to false (default)
# to preserve the original single-draft behavior.
SECTIONED_REPORT=false

# --- SearXNG Web Search ---
# Cluster-deployed: run 0_setup/0_instructor_deploy_infra.sh (instructor)
#                   or set the URL provided by your instructor
SEARXNG_URL=http://localhost:8888

# --- MCP Server URLs (local development) ---
# Use 127.0.0.1 (not localhost) to avoid IPv6 resolution issues with httpx
VECTOR_SEARCH_MCP_URL=http://127.0.0.1:9002
WEB_SEARCH_MCP_URL=http://127.0.0.1:9003
VERIFICATION_MCP_URL=http://127.0.0.1:9004
OBSERVABILITY_MCP_URL=http://127.0.0.1:9005
LEGACY_CBS_MCP_URL=http://127.0.0.1:9006

# --- Fraud Detection Model (optional) ---
# Set to a deployed encoder model endpoint for real fraud scoring.
# Leave empty to use deterministic mock scoring (demo mode).
FRAUD_MODEL_URL=

# --- UI Ports (local development) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_URL=http://localhost:8000

# --- AG-UI / Next.js Frontend ---
NEXT_PUBLIC_AGENT_URL=http://localhost:8000/agent
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Container Registry (Quay.io) ---
REGISTRY=quay.io/<your-org>
IMAGE_TAG=latest

# --- MLflow (RHOAI 3.4+) ---
# Get tracking URI (dedicated MLflow route, NOT the dashboard /mlflow URL):
#   oc get route mlflow -n redhat-ods-applications -o jsonpath='https://{.spec.host}'
# Token options:
#   Option A (short-lived): oc whoami --show-token
#   Option B (non-expiring SA token):
#     oc create sa mlflow-client -n <project-name>
#     oc create token mlflow-client --duration=0s -n <project-name>
MLFLOW_TRACKING_URI=<output-of-uri-command>
MLFLOW_TRACKING_TOKEN=<output-of-token-command>
MLFLOW_WORKSPACE=<project-name>
MLFLOW_EXPERIMENT_NAME=deep-research-harness
# For self-signed certs: MLFLOW_TRACKING_INSECURE_TLS=true

# --- Authentication ---
# Required for chat history. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# (Legacy Chainlit auth secret still supported for backward compatibility)
CHAINLIT_AUTH_SECRET=<run-chainlit-create-secret>
CHAINLIT_ADMIN_USER=admin
CHAINLIT_ADMIN_PASSWORD=admin
# Optional: override the Chainlit SQLite DB path (default: data/chainlit.db)
# CHAINLIT_DB_PATH=data/chainlit.db

# --- OpenShell (Claim-Evidence Graph sandbox execution) ---
# ADMIN PREREQUISITE — install with: ./scripts/install-openshell.sh
# The script installs Agent Sandbox CRDs + OpenShell gateway in one step.
# TP phase: TLS disabled, unauthenticated access for lab convenience.
#
# Developer workstation setup (after admin install):
#   openshell gateway add http://127.0.0.1:8080 --name cluster-forward --local
#   oc port-forward svc/openshell 8080:8080 -n openshell
#   openshell sandbox list  # verify
#
# `make setup` auto-detects and port-forwards if OpenShell is on the cluster.
# OpenShell community base image (includes iproute2 for network isolation).
# Standard python images do NOT work — they lack iproute2.
# Cached on cluster nodes after first pull (~3.2GB initial, instant thereafter).
OPENSHELL_RENDERER_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest
OPENSHELL_WORKSPACE=default
OPENSHELL_CPU=500m
OPENSHELL_MEMORY=512Mi
OPENSHELL_TIMEOUT_SECONDS=60
OPENSHELL_POLICY_PATH=config/openshell/claim-evidence-policy.yaml
OPENSHELL_REQUIRE_APPROVAL=true
# Artifact planning timeout (seconds) — structured JSON generation can be slow
ARTIFACT_PLAN_TIMEOUT=120
# Gateway URL (must match gateway registration endpoint)
OPENSHELL_GATEWAY_URL=http://127.0.0.1:8080

# --- OpenShift (populated by setup notebooks) ---
CLUSTER_DOMAIN=
NAMESPACE=doc-research-lab
