# =============================================================================
# RHOAI Custom Deep Research Lab — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp sample.env .env
#
# Two access modes are supported:
#
#   Mode A — Direct vLLM route (no MaaS)
#     LLM_BASE_URL  = https://<model-route>/v1
#     LLM_API_KEY   = <oc-token or "not-needed">
#     MAAS_API_KEY  = (leave empty)
#
#   Mode B — MaaS API gateway
#     LLM_BASE_URL  = https://<maas-api-route>/<namespace>/<model>/v1
#     LLM_API_KEY   = (ignored when MAAS_API_KEY is set)
#     MAAS_API_KEY  = sk-oai-... (MaaS API key bound to subscription)
#
# =============================================================================

# --- LLM Configuration (RHOAI Model Serving / OpenAI-compatible) ---
# Direct route example : https://granite-llm-doc-research.apps.cluster.example.com/v1
# MaaS gateway example : https://maas-api.apps.cluster.example.com/demo/granite-llm/v1
LLM_BASE_URL=https://<your-llm-route>/v1
LLM_API_KEY=<your-api-key>
LLM_MODEL=granite-3.3-8b-instruct

# MaaS API key (required for MaaS gateway, leave empty for direct routes)
# POST /chat/completions requires this key; OC tokens only work for GET /models
MAAS_API_KEY=

# --- Embedding Model ---
# Required: Set your embedding endpoint URL before starting the lab.
# Example: https://granite-embedding-doc-research.apps.cluster.example.com/v1
EMBEDDING_BASE_URL=https://<your-embedding-route>/v1
EMBEDDING_API_KEY=<your-api-key>
EMBEDDING_MODEL=granite-embedding-278m-multilingual

# --- SQLite Database ---
# Single file for all data (documents, sessions, traces). No server needed.
# Default (when unset): <project-root>/data/research.db (absolute, set by db.py)
# Only override if you need a custom location.
# SQLITE_DB_PATH=/absolute/path/to/research.db

# --- PostgreSQL (checkpointing + pgvector) ---
# Required for chat history persistence, LangGraph checkpointing, and vector search.
# Start with: docker compose up -d
POSTGRES_URL=postgresql://research:research@localhost:5432/research_db

# --- SSL Verification ---
# Set to false for self-signed certificates on sandbox/lab clusters
VERIFY_SSL=true

# --- LLM Token Limits ---
# always set max_tokens to prevent MaaS gateway timeouts.
LLM_MAX_TOKEN_SMALL=512
LLM_MAX_TOKEN_MEDIUM=1024
LLM_MAX_TOKEN_LARGE=4096

# --- Harness Configuration ---
QUALITY_THRESHOLD=7.0
MAX_ITERATIONS=2
PARALLEL_WORKERS=3

# Sectioned report: when true, planning decomposes queries into sub-topics
# and the execute phase writes per-section reports. Set to false (default)
# to preserve the original single-draft behavior.
SECTIONED_REPORT=false

# --- SearXNG Web Search ---
# Cluster-deployed: run 0_setup/0_instructor_deploy_infra.sh (instructor)
#                   or set the URL provided by your instructor
SEARXNG_URL=http://localhost:8888

# --- MCP Server URLs (local development) ---
# Use 127.0.0.1 (not localhost) to avoid IPv6 resolution issues with httpx
VECTOR_SEARCH_MCP_URL=http://127.0.0.1:9002
WEB_SEARCH_MCP_URL=http://127.0.0.1:9003
VERIFICATION_MCP_URL=http://127.0.0.1:9004
OBSERVABILITY_MCP_URL=http://127.0.0.1:9005
LEGACY_CBS_MCP_URL=http://127.0.0.1:9006

# --- Fraud Detection Model (optional) ---
# Set to a deployed encoder model endpoint for real fraud scoring.
# Leave empty to use deterministic mock scoring (demo mode).
FRAUD_MODEL_URL=

# --- UI Ports (local development) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_URL=http://localhost:8000

# --- AG-UI / Next.js Frontend ---
NEXT_PUBLIC_AGENT_URL=http://localhost:8000/agent
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Container Registry (Quay.io) ---
REGISTRY=quay.io/<your-org>
IMAGE_TAG=latest

# --- MLflow (RHOAI 3.4+) ---
# Get URI:   echo "$(oc get route rhods-dashboard -n redhat-ods-applications -o jsonpath='https://{.spec.host}')/mlflow"
# Token options:
#   Option A (short-lived): oc whoami --show-token
#   Option B (non-expiring SA token):
#     oc create sa mlflow-client -n <project-name>
#     oc create token mlflow-client --duration=0s -n <project-name>
MLFLOW_TRACKING_URI=<output-of-uri-command>
MLFLOW_TRACKING_TOKEN=<output-of-token-command>
MLFLOW_WORKSPACE=<project-name>
MLFLOW_EXPERIMENT_NAME=deep-research-harness
# For self-signed certs: MLFLOW_TRACKING_INSECURE_TLS=true

# --- Authentication ---
# Required for chat history. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# (Legacy Chainlit auth secret still supported for backward compatibility)
CHAINLIT_AUTH_SECRET=<run-chainlit-create-secret>
CHAINLIT_ADMIN_USER=admin
CHAINLIT_ADMIN_PASSWORD=admin
# Optional: override the Chainlit SQLite DB path (default: data/chainlit.db)
# CHAINLIT_DB_PATH=data/chainlit.db

# --- OpenShift (populated by setup notebooks) ---
CLUSTER_DOMAIN=
NAMESPACE=doc-research-lab
